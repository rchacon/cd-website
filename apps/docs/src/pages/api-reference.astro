---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ApiReference from '../components/ApiReference.astro';

const SPEC_URL = 'https://cd-platform-openapi-spec-658430303091.s3.us-west-2.amazonaws.com/openapi.json';
---

<StarlightPage frontmatter={{ title: 'API Reference' }} hasSidebar={false}>
  <p>
    Generated from cd-api's OpenAPI schema. For the narrative version (deployment model, error
    handling, vacancy-vs-404 semantics), see <a href="/api/">API</a>.
  </p>
  <ApiReference specUrl={SPEC_URL} />
</StarlightPage>
