---
interface Props {
  code: string;
}

const { code } = Astro.props;
---

<div class="not-content mermaid-figure">
  <div class="mermaid-card">
    <pre class="mermaid">{code}</pre>
    <span class="enlarge-hint" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M10 2h4v4M6 14H2v-4M14 2 9 7M2 14l5-5" />
      </svg>
      Click to enlarge
    </span>
  </div>
  <dialog class="mermaid-dialog" aria-label="Enlarged diagram">
    <button class="mermaid-dialog-close" type="button" aria-label="Close">
      <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
        <path d="M3 3l10 10M13 3 3 13" />
      </svg>
    </button>
    <div class="mermaid-dialog-body"></div>
  </dialog>
</div>

<style>
  .mermaid-figure {
    margin-block: 1.5rem;
  }

  .mermaid-card {
    position: relative;
    background: #ffffff;
    border: 1px solid #d8e2f0;
    border-radius: 1rem;
    padding: 1.5rem 1.5rem 2.25rem;
    overflow-x: auto;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  /* Only a diagram drawn noticeably smaller than its natural size is
     enlargeable -- the script toggles this class. */
  .mermaid-card.is-enlargeable {
    cursor: zoom-in;
  }

  .mermaid-card.is-enlargeable:hover {
    border-color: #27619c;
    box-shadow: 0 2px 12px rgba(10, 34, 70, 0.08);
  }

  .mermaid-card:focus-visible {
    outline: 2px solid #27619c;
    outline-offset: 2px;
  }

  .enlarge-hint {
    display: none;
    position: absolute;
    right: 1rem;
    bottom: 0.65rem;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: #27619c;
    opacity: 0.75;
    pointer-events: none;
  }

  .mermaid-card.is-enlargeable .enlarge-hint {
    display: inline-flex;
  }

  .mermaid-card:hover .enlarge-hint,
  .mermaid-card:focus-visible .enlarge-hint {
    opacity: 1;
  }

  .mermaid-dialog {
    /* Starlight's reset zeroes margins, which strips the browser's default
       centering of a modal <dialog> and pins it to the top-left corner. */
    margin: auto;
    width: min(95vw, 1600px);
    max-width: 95vw;
    max-height: 92vh;
    padding: 2.75rem 1.5rem 1.5rem;
    border: none;
    border-radius: 1rem;
    background: #ffffff;
    box-shadow: 0 20px 60px rgba(10, 34, 70, 0.35);
    overflow: hidden;
  }

  .mermaid-dialog::backdrop {
    background: rgba(10, 34, 70, 0.6);
  }

  .mermaid-dialog-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #d8e2f0;
    border-radius: 999px;
    background: #ffffff;
    color: #0a2246;
    cursor: pointer;
  }

  .mermaid-dialog-close:hover {
    border-color: #27619c;
  }

  .mermaid-dialog-body {
    max-height: calc(92vh - 4.25rem);
    overflow: auto;
  }

  /* The enlarged SVG is a clone inserted by the script below, so it has no
     scoped-style attribute -- :global() is what reaches it. Its pixel size is
     set by the script; the body scrolls if that's bigger than the dialog. */
  .mermaid-dialog-body :global(svg) {
    display: block;
    max-width: none;
    margin-inline: auto;
  }

  @media (max-width: 640px) {
    .mermaid-dialog {
      padding-inline: 0.75rem;
    }
  }
</style>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    themeVariables: {
      primaryColor: '#eef3fa',
      primaryTextColor: '#0a2246',
      primaryBorderColor: '#27619c',
      lineColor: '#27619c',
      secondaryColor: '#cfe0f2',
      tertiaryColor: '#ffffff',
      fontFamily: 'Inter, ui-sans-serif, system-ui, sans-serif'
    }
  });

  await mermaid.run({ querySelector: '.mermaid' });

  document.querySelectorAll<HTMLElement>('.mermaid-figure').forEach((figure) => {
    const card = figure.querySelector<HTMLElement>('.mermaid-card')!;
    const dialog = figure.querySelector<HTMLDialogElement>('.mermaid-dialog')!;
    const body = dialog.querySelector<HTMLElement>('.mermaid-dialog-body')!;

    const inlineSvg = () => card.querySelector<SVGSVGElement>('pre.mermaid svg');

    // How much the inline drawing is scaled relative to its natural
    // (viewBox) size. Below this threshold the diagram has been squeezed to
    // fit the content column and enlarging it helps; at or near full size
    // (e.g. a tall, narrow diagram on desktop), "enlarging" would only fit it
    // to the window -- i.e. make it smaller -- so it isn't offered.
    const ENLARGEABLE_BELOW = 0.9;
    const inlineScale = (svg: SVGSVGElement) => {
      const vw = svg.viewBox.baseVal.width;
      return vw ? svg.getBoundingClientRect().width / vw : 1;
    };

    const setEnlargeable = () => {
      const svg = inlineSvg();
      const on = !!svg && inlineScale(svg) < ENLARGEABLE_BELOW;
      card.classList.toggle('is-enlargeable', on);
      if (on) {
        card.setAttribute('role', 'button');
        card.setAttribute('tabindex', '0');
        card.setAttribute('aria-haspopup', 'dialog');
        card.setAttribute('aria-label', 'Enlarge diagram');
      } else {
        for (const a of ['role', 'tabindex', 'aria-haspopup', 'aria-label']) card.removeAttribute(a);
      }
    };
    setEnlargeable();
    // The inline scale changes with the window width (a diagram can be full
    // size on desktop but squeezed on a phone).
    new ResizeObserver(setEnlargeable).observe(card);

    const open = () => {
      const svg = inlineSvg();
      if (!svg || !card.classList.contains('is-enlargeable')) return;
      // A fresh clone per open, so the dialog never holds a stale copy.
      // Mermaid pins the inline SVG with an inline max-width; the clone's
      // size is set explicitly by sizeClone() instead.
      const clone = svg.cloneNode(true) as SVGSVGElement;
      clone.style.removeProperty('max-width');
      clone.removeAttribute('width');
      clone.removeAttribute('height');
      // Mermaid scopes its generated <style> to the SVG's id; renaming the
      // clone would break that, but two elements sharing an id only matters
      // for lookups, which nothing here does.
      body.replaceChildren(clone);
      dialog.showModal();
      sizeClone(clone, svg);
    };

    // Fits the whole diagram in the dialog when that's at least natural size;
    // otherwise shows it at natural size (readable) and lets the dialog
    // scroll. On wide screens natural size is capped at the dialog's width
    // (scroll down, never sideways); on phones it may exceed it and pan.
    const sizeClone = (clone: SVGSVGElement, inline: SVGSVGElement) => {
      const { width: vw, height: vh } = inline.viewBox.baseVal;
      if (!vw || !vh) return;
      const availW = body.clientWidth;
      const availH = parseFloat(getComputedStyle(body).maxHeight) || window.innerHeight * 0.8;
      const fit = Math.min(availW / vw, availH / vh);
      const wide = window.matchMedia('(min-width: 641px)').matches;
      const scale = Math.max(fit, wide ? Math.min(1, availW / vw) : 1);
      clone.style.width = `${vw * scale}px`;
      clone.style.height = `${vh * scale}px`;
    };

    card.addEventListener('click', open);
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open();
      }
    });

    dialog.querySelector('.mermaid-dialog-close')!.addEventListener('click', () => dialog.close());
    // Close on a click outside the dialog's box (on the backdrop). Checked
    // by position, not `target === dialog`, since a click on the dialog's
    // own padding also targets the dialog. Esc closes it natively.
    dialog.addEventListener('click', (e) => {
      const r = dialog.getBoundingClientRect();
      const inside =
        e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) dialog.close();
    });
  });
</script>
