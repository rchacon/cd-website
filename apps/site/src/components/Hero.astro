---
---

<section class="relative overflow-hidden bg-gradient-to-b from-blue-200/20 to-white">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:py-28">
    <div>
      <p class="mb-4 inline-block rounded-full bg-navy-900/5 px-4 py-1.5 text-sm font-semibold text-navy-800">
        Civic data. Built for impact.
      </p>
      <h1 class="text-4xl font-bold leading-tight tracking-tight text-navy-900 sm:text-5xl">
        Authoritative U.S. Congress data,<br class="hidden sm:block" /> shipped as an API and a WordPress plugin.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-navy-700">
        CivicDog pulls straight from the official Congress.gov API, keeps it fresh with an automated
        Airflow pipeline, and serves it through a clean REST API and a production WordPress plugin —
        no fragile scraping required.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="https://docs.civicdog.com/"
          class="rounded-full bg-navy-900 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-600"
        >
          See how it's built
        </a>
        <a
          href="#product"
          class="rounded-full border border-navy-900/20 px-6 py-3 text-sm font-semibold text-navy-900 transition hover:border-blue-500 hover:text-blue-500"
        >
          Explore the product
        </a>
      </div>
    </div>

    <div class="mx-auto w-full max-w-md lg:max-w-none">
      <picture>
        <source srcset="/logo/civicdog-logo-transparent.webp" type="image/webp" />
        <img
          src="/logo/civicdog-logo-transparent.png"
          alt="CivicDog — civic data. Built for impact."
          width="1200"
          height="800"
          class="w-full"
        />
      </picture>
    </div>
  </div>
</section>
