---
const results = [
  {
    bill: 'H.R. 1234 · 118th Congress',
    title: 'Housing Affordability and Supply Act',
    vote: 'Voted Yea',
    detail: 'On Passage · Passed · Apr 18, 2024'
  },
  {
    bill: 'H.R. 5678 · 118th Congress',
    title: 'Zoning Preemption Repeal Act',
    vote: 'Voted Nay',
    detail: 'On Passage · Failed · Sep 9, 2024'
  }
];
---

<section id="product" class="border-b border-navy-900/10 bg-blue-200/10 py-20">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-500">Product · Web App</p>
      <h2 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">The full lookup experience, live at app.civicdog.com</h2>
      <p class="mt-4 text-lg text-navy-700">
        <code class="rounded bg-navy-900/5 px-1.5 py-0.5 text-base">cd-webapp</code> is the core CivicDog
        product — a React app where anyone can find their U.S. senators and House representative by state
        and district or by street address, then open any member's page for identity, contact details, and
        how they've voted.
      </p>
      <ul class="mt-6 space-y-3 text-navy-800">
        <li class="flex gap-3">
          <span class="text-blue-500">&#9679;</span>
          <span>
            <span class="font-semibold">Plain-language voting-record search</span> — describe a topic like
            "teaching gender identity in schools" and get the bills that member actually voted on, closest
            matches first. No bill numbers, no legal jargon.
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-blue-500">&#9679;</span>
          <span>
            <span class="font-semibold">AI-generated summaries</span> of a member's record on a topic,
            written from their recorded votes — sign in to generate one.
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-blue-500">&#9679;</span>
          Address-based lookup — no need to know your district number; it's geocoded server-side.
        </li>
        <li class="flex gap-3">
          <span class="text-blue-500">&#9679;</span>
          Free to use, no account needed to search — hosted Cognito sign-in is only for AI summaries.
        </li>
      </ul>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <a href="https://app.civicdog.com" class="inline-block font-semibold text-blue-500 hover:text-blue-600">
          Open the app &rarr;
        </a>
        <a href="https://docs.civicdog.com/" class="inline-block font-semibold text-navy-700 hover:text-blue-600">
          How it's built &rarr;
        </a>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl bg-navy-950 shadow-xl">
      <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
        <span class="h-3 w-3 rounded-full bg-blue-300/40"></span>
        <span class="h-3 w-3 rounded-full bg-blue-300/40"></span>
        <span class="h-3 w-3 rounded-full bg-blue-300/40"></span>
        <span class="ml-2 text-xs font-medium text-blue-200">app.civicdog.com</span>
      </div>
      <div class="p-5">
        <p class="text-sm font-semibold text-white">How did Rep. Nikema Williams vote on&hellip;</p>
        <div class="mt-3 flex gap-2">
          <div class="flex-1 rounded-lg bg-white px-3 py-2 text-sm text-navy-700">affordable housing</div>
          <span class="rounded-lg bg-blue-500 px-4 py-2 text-sm font-semibold text-white">Search</span>
        </div>

        <div class="mt-4 flex items-center justify-between">
          <p class="text-xs text-blue-200">2 bills related to &ldquo;affordable housing&rdquo;</p>
          <span class="inline-flex items-center gap-1 text-xs font-semibold text-blue-300">
            &#10022; Summarize with AI
          </span>
        </div>

        <div class="mt-3 space-y-3">
          {
            results.map((r) => (
              <div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/10">
                <p class="text-xs font-medium text-blue-200">{r.bill}</p>
                <p class="mt-1 text-sm font-semibold text-white">{r.title}</p>
                <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-white/10 pt-3">
                  <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-semibold text-blue-100 ring-1 ring-white/15">
                    {r.vote}
                  </span>
                  <span class="text-xs text-blue-200">{r.detail}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
