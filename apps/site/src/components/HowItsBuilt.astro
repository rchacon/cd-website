---
const highlights = [
  {
    title: 'Infrastructure as Code',
    detail: 'Every AWS resource — VPC, RDS, Lambda, KMS — is provisioned by Terraform with independent, reviewable state per module.'
  },
  {
    title: 'Keyless deploys',
    detail: 'GitHub OIDC assumes scoped IAM roles at deploy time. No long-lived AWS credentials live in CI, ever.'
  },
  {
    title: 'Zero public IPs',
    detail: 'RDS, Lambda, and the Airflow host all sit in private subnets. Admin access is SSM Session Manager only.'
  },
  {
    title: 'Cost engineered, not guessed',
    detail: 'Self-hosted Airflow over MWAA, SSM over a VPN — every trade-off is measured and documented.'
  }
];
---

<section class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-500">How it's built</p>
      <h2 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">Engineering built to hold up under review</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-navy-700">
        This site's engineering docs go deep on the data pipeline, the API, the AWS infrastructure, and the
        automation behind CivicDog — including the trade-offs and the parts still on the roadmap.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        highlights.map((item) => (
          <div class="rounded-2xl border border-navy-900/10 p-6">
            <p class="font-semibold text-navy-900">{item.title}</p>
            <p class="mt-2 text-sm text-navy-600">{item.detail}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href="https://docs.civicdog.com/"
        class="inline-block rounded-full bg-navy-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-blue-600"
      >
        Read the full engineering docs
      </a>
    </div>
  </div>
</section>
