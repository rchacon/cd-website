---
---

<section class="border-b border-navy-900/10 bg-blue-200/10 py-20">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-500">Product · WordPress Plugin</p>
      <h2 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">Drop-in "find your representative" for any WordPress site</h2>
      <p class="mt-4 text-lg text-navy-700">
        <code class="rounded bg-navy-900/5 px-1.5 py-0.5 text-base">cd-lookup</code> is a WordPress plugin —
        used in production on a real advocacy site — that lets any visitor type in an address and see their
        senators and House representative in seconds.
      </p>
      <ul class="mt-6 space-y-3 text-navy-800">
        <li class="flex gap-3">
          <span class="text-blue-500">&#9679;</span>
          One shortcode: <code class="rounded bg-navy-900/5 px-1.5 py-0.5 text-sm">[cd_lookup]</code>
        </li>
        <li class="flex gap-3">
          <span class="text-blue-500">&#9679;</span>
          Census Bureau geocoding + CivicDog's own API, cached via WordPress transients
        </li>
        <li class="flex gap-3">
          <span class="text-blue-500">&#9679;</span>
          Sanitized output, WordPress Coding Standards compliant, fully unit tested
        </li>
        <li class="flex gap-3">
          <span class="text-blue-500">&#9679;</span>
          <span>
            Installs like any other plugin — download the zip from{' '}
            <a
              href="https://github.com/rchacon/cd-lookup/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-blue-500 underline underline-offset-2 hover:text-blue-600"
            >
              GitHub Releases
            </a>{' '}
            and upload it under Plugins &rarr; Add New
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-blue-500">&#9679;</span>
          <span>
            Requires a{' '}
            <a href="#api-key" class="font-medium text-blue-500 underline underline-offset-2 hover:text-blue-600">
              free CivicDog API key
            </a>{' '}
            , entered under Settings &rarr; CD Lookup
          </span>
        </li>
      </ul>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <a href="https://docs.civicdog.com/wordpress-plugin/" class="inline-block font-semibold text-blue-500 hover:text-blue-600">
          Read the plugin internals &rarr;
        </a>
        <a
          href="https://github.com/rchacon/cd-lookup/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block font-semibold text-navy-700 hover:text-blue-600"
        >
          Download latest release &rarr;
        </a>
      </div>
    </div>

    <div class="rounded-2xl border border-navy-900/10 bg-white p-6 shadow-xl">
      <p class="text-sm font-semibold text-navy-800">Find Your Representative</p>
      <div class="mt-3 flex gap-2">
        <div class="flex-1 rounded-lg border border-navy-900/15 px-3 py-2 text-sm text-navy-500">
          1600 Pennsylvania Ave NW
        </div>
        <span class="rounded-lg bg-navy-900 px-4 py-2 text-sm font-semibold text-white">Search</span>
      </div>

      <div class="mt-5 space-y-3">
        <div class="flex items-center gap-3 rounded-lg border border-navy-900/10 p-3">
          <div class="h-10 w-10 shrink-0 rounded-full bg-blue-200"></div>
          <div>
            <p class="text-sm font-semibold text-navy-900">Rep. Eleanor Holmes Norton</p>
            <p class="text-xs text-navy-500">Democratic &middot; District Delegate</p>
          </div>
        </div>
        <div class="flex items-center gap-3 rounded-lg border border-navy-900/10 p-3">
          <div class="h-10 w-10 shrink-0 rounded-full bg-blue-200"></div>
          <div>
            <p class="text-sm font-semibold text-navy-900">Sen. Jane Example</p>
            <p class="text-xs text-navy-500">Senator</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
