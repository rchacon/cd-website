---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ProblemStatement from '../components/ProblemStatement.astro';
import ProductWebapp from '../components/ProductWebapp.astro';
import ProductApi from '../components/ProductApi.astro';
import ProductWordPress from '../components/ProductWordPress.astro';
import HowItsBuilt from '../components/HowItsBuilt.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout
  title="CivicDog — Civic data. Built for impact."
  description="See how your U.S. senators and representative have actually voted, explained in plain language. CivicDog's free app is built on official data straight from Congress — and the same data powers a developer API and a WordPress plugin."
>
  <SiteHeader />
  <Hero />
  <ProblemStatement />
  <ProductWebapp />
  <ProductApi />
  <ProductWordPress />
  <HowItsBuilt />
  <SiteFooter />
</Layout>
